# Production build (`vite build`). Baked into the deployed bundle.
# Points the console at the live Django backend hosted on Render.
# Vite gives this mode-specific file priority over the generic .env.local,
# so local `vite dev` (which reads .env.local) still targets local Docker.
VITE_USE_MOCK_DATA=false
VITE_API_BASE_URL=https://education-os-backend.onrender.com
