# Production build (`vite build`). Baked into the deployed bundle.
# Points the console at the deployed AWS backend. Flip VITE_APP_ENV to `staging`
# to build against Render, or `local` for the Docker backend.
# Vite gives this mode-specific file priority over the generic .env.local.
VITE_USE_MOCK_DATA=false
VITE_APP_ENV=production
VITE_PROD_API_BASE_URL=https://aicampusos.duckdns.org
VITE_STAGING_API_BASE_URL=https://education-os-backend.onrender.com
