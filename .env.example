# AI Campus OS — Admin Console environment
#
# By default the console runs on seeded MOCK data (localStorage), so it works with no backend.
# To connect to a live Django backend instead, copy this file to `.env.local` and set
# VITE_USE_MOCK_DATA=false. `VITE_APP_ENV` then chooses which backend (matches the mobile app):
#
#   VITE_APP_ENV=production  -> VITE_PROD_API_BASE_URL    (deployed AWS server)
#   VITE_APP_ENV=staging     -> VITE_STAGING_API_BASE_URL (Render server)
#   VITE_APP_ENV=local       -> VITE_LOCAL_API_BASE_URL   (Docker backend on your machine)
#
# Base URLs are the bare host (no /api/v1) — the HTTP client adds /api/v1 itself.
# Admin login for the real backend uses the seeded admin credentials (admin@campus.edu.in).

VITE_USE_MOCK_DATA=false
VITE_APP_ENV=production

# Deployed AWS backend (plain http, port 80).
VITE_PROD_API_BASE_URL=https://aicampusos.duckdns.org

# Render / staging backend.
VITE_STAGING_API_BASE_URL=https://education-os-backend.onrender.com

# Local Docker backend.
VITE_LOCAL_API_BASE_URL=http://127.0.0.1:8000

# Optional: an explicit override that wins over VITE_APP_ENV entirely.
# VITE_API_BASE_URL=http://13.206.201.237
