# AI Campus OS — Admin Console environment
#
# By default the console runs on seeded MOCK data (localStorage), so it works with no backend.
# To connect to the live Django backend instead, copy this file to `.env.local` and set:
#
# VITE_USE_MOCK_DATA=false
# VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Admin login for the real backend uses the seeded admin credentials (see the backend's
# seed_demo command). The mock login is admin@campus.edu.in / campus123.

VITE_USE_MOCK_DATA=true
VITE_API_BASE_URL=http://127.0.0.1:8000
